#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# adxc-demo command registry viewer and runner
# -----------------------------------------------------------------------------

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADXC_ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck source=../lib/adxc-common.sh
source "${ADXC_ROOT_DIR}/lib/adxc-common.sh"

adxc_usage() {
    printf 'Usage:\n'
    printf '  adxc-cmd --list\n'
    printf '  adxc-cmd --profile <PROFILE>\n'
    printf '  adxc-cmd --run <PROFILE> <COMMAND> [args...]\n'
}

adxc_list_all_commands() {
    printf 'COMMAND REPOSITORY\n'
    find "${ADXC_COMMANDS_DIR}" -mindepth 1 -maxdepth 1 -type f -name '*.cmd' -printf '  %f\n' | sort
}

adxc_list_profile_commands() {
    local profile_name="$1"
    local link_file
    printf 'ATTACHED COMMANDS FOR %s\n' "${profile_name}"
    for link_file in "${ADXC_PROFILES_DIR}/${profile_name}/commands"/*.link; do
        [[ -f "${link_file}" ]] || continue
        COMMAND_NAME=""
        COMMAND_FILE=""
        # shellcheck source=/dev/null
        source "${link_file}"
        printf '  %-24s %s\n' "${COMMAND_NAME}" "${COMMAND_FILE}"
    done
}

adxc_run_profile_command() {
    local profile_name="$1"
    local command_name="$2"
    shift 2
    local link_file="${ADXC_PROFILES_DIR}/${profile_name}/commands/${command_name}.link"
    [[ -f "${link_file}" ]] || { adxc_print_error "Command is not attached: ${command_name}"; exit 1; }
    COMMAND_FILE=""
    # shellcheck source=/dev/null
    source "${link_file}"
    "${ADXC_ROOT_DIR}/${COMMAND_FILE}" "$@"
}

case "${1:-}" in
    --list) adxc_list_all_commands ;;
    --profile) [[ -n "${2:-}" ]] || { adxc_usage; exit 1; }; adxc_list_profile_commands "$2" ;;
    --run) [[ -n "${2:-}" && -n "${3:-}" ]] || { adxc_usage; exit 1; }; adxc_run_profile_command "$2" "$3" "${@:4}" ;;
    *) adxc_usage ;;
esac
